<%- include('../partials/header', { title: 'Create New Post - StudentCalc Blog' }) %>

<main class="max-w-3xl mx-auto my-10 p-6 bg-white border border-zinc-200 rounded-md">
  <h1 class="text-3xl font-bold mb-6 text-zinc-950" style="font-family: 'Google Sans Code';">Create New Post</h1>

  <% if (errors && errors.length > 0) { %>
    <div class="mb-6 p-4 bg-red-100 text-red-700 text-sm rounded">
      <ul class="list-disc pl-5 space-y-1">
        <% errors.forEach(err => { %>
          <li><%= err.msg %></li>
        <% }); %>
      </ul>
    </div>
  <% } %>

  <form action="/admin/create" method="POST" class="space-y-6">
    <div>
      <label for="title" class="block text-sm font-semibold text-zinc-900 mb-1">Title</label>
      <input type="text" id="title" name="title" value="<%= formData.title || '' %>" required maxlength="150" class="w-full px-3 py-2 border border-zinc-300 rounded focus:outline-none focus:border-zinc-950">
    </div>

    <div>
      <label for="excerpt" class="block text-sm font-semibold text-zinc-900 mb-1">Excerpt (Short Summary)</label>
      <textarea id="excerpt" name="excerpt" rows="2" maxlength="300" required class="w-full px-3 py-2 border border-zinc-300 rounded focus:outline-none focus:border-zinc-950"><%= formData.excerpt || '' %></textarea>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="category" class="block text-sm font-semibold text-zinc-900 mb-1">Category</label>
        <select id="category" name="category" required class="w-full px-3 py-2 border border-zinc-300 rounded focus:outline-none focus:border-zinc-950">
          <option value="Health" <%= formData.category === 'Health' ? 'selected' : '' %>>Health</option>
          <option value="Science" <%= formData.category === 'Science' ? 'selected' : '' %>>Science</option>
          <option value="Technology" <%= formData.category === 'Technology' ? 'selected' : '' %>>Technology</option>
          <option value="Food" <%= formData.category === 'Food' ? 'selected' : '' %>>Food</option>
        </select>
      </div>

      <div>
        <label for="coverUrl" class="block text-sm font-semibold text-zinc-900 mb-1">Cover Image URL</label>
        <input type="url" id="coverUrl" name="coverUrl" value="<%= formData.coverUrl || '' %>" placeholder="https://images.unsplash.com/photo-xxx..." required class="w-full px-3 py-2 border border-zinc-300 rounded focus:outline-none focus:border-zinc-950">
      </div>
    </div>

    <div>
      <label for="coverAlt" class="block text-sm font-semibold text-zinc-900 mb-1">Cover Image Alt Text</label>
      <input type="text" id="coverAlt" name="coverAlt" value="<%= formData.coverAlt || '' %>" placeholder="Description of image" class="w-full px-3 py-2 border border-zinc-300 rounded focus:outline-none focus:border-zinc-950">
    </div>

    <div>
      <label for="contentMarkdown" class="block text-sm font-semibold text-zinc-900 mb-1">Content (Markdown)</label>
      <p class="text-xs text-zinc-500 mb-2">Tip: For body images, use standard markdown syntax with any image link: <code>![alt text](https://images.unsplash.com/photo-xxx)</code></p>
      <textarea id="contentMarkdown" name="contentMarkdown" rows="10" required class="w-full p-3 font-mono text-sm border border-zinc-300 rounded focus:outline-none focus:border-zinc-950"><%= formData.contentMarkdown || '' %></textarea>
    </div>

    <div class="flex items-center gap-6 pt-2">
      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="isTrending" class="w-4 h-4 text-zinc-950 rounded" <%= formData.isTrending ? 'checked' : '' %>>
        <span class="text-sm font-medium text-zinc-900">Mark as Trending</span>
      </label>

      <label class="flex items-center gap-2 cursor-pointer">
        <input type="checkbox" name="isTopStory" class="w-4 h-4 text-zinc-950 rounded" <%= formData.isTopStory ? 'checked' : '' %>>
        <span class="text-sm font-medium text-zinc-900">Mark as Top Story (Hero Banner)</span>
      </label>
    </div>

    <button type="submit" class="w-full py-3 bg-zinc-950 text-white font-semibold rounded hover:bg-zinc-800 transition">Publish Post</button>
  </form>
</main>

</body>
</html>