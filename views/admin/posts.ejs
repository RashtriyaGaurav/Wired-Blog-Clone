<%- include('../partials/header', { title: 'Manage Posts' }) %>

<main class="flex-1 max-w-6xl mx-auto py-8 px-4 w-full">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold text-zinc-950" style="font-family: 'Google Sans Code';">Manage Posts</h1>
    <a href="/admin/create" class="px-4 py-2 bg-zinc-950 text-white rounded text-sm font-semibold hover:bg-zinc-800 transition">+ New Post</a>
  </div>

  <% if (flash) { %>
    <div class="mb-4 px-4 py-3 rounded border border-green-200 bg-green-50 text-green-700 text-sm"><%= flash %></div>
  <% } %>

  <% if (posts.length === 0) { %>
    <p class="text-zinc-500 py-10 text-center">Abhi koi post nahi hai.</p>
  <% } else { %>
    <div class="overflow-x-auto border border-zinc-200 rounded">
      <table class="w-full text-sm text-left">
        <thead class="bg-zinc-50 text-zinc-600 uppercase text-xs tracking-wider">
          <tr>
            <th class="px-4 py-3">Title</th>
            <th class="px-4 py-3">Category</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3">Views</th>
            <th class="px-4 py-3">Likes</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-200">
          <% posts.forEach(p => { %>
            <tr class="hover:bg-zinc-50">
              <td class="px-4 py-3 max-w-xs">
                <a href="/post/<%= p.slug %>" class="font-semibold text-zinc-950 hover:underline line-clamp-2"><%= p.title %></a>
                <div class="mt-1 flex gap-2 text-[11px]">
                  <% if (p.isTrending) { %><span class="px-1.5 py-0.5 bg-amber-100 text-amber-700 rounded">Trending</span><% } %>
                  <% if (p.isTopStory) { %><span class="px-1.5 py-0.5 bg-blue-100 text-blue-700 rounded">Top story</span><% } %>
                </div>
              </td>
              <td class="px-4 py-3"><%= p.category %></td>
              <td class="px-4 py-3">
                <% if (p.published) { %>
                  <span class="text-green-700">Published</span>
                <% } else { %>
                  <span class="text-zinc-500">Draft</span>
                <% } %>
              </td>
              <td class="px-4 py-3"><%= (p.views || 0).toLocaleString('en-US') %></td>
              <td class="px-4 py-3"><%= (p.likeCount || 0).toLocaleString('en-US') %></td>
              <td class="px-4 py-3">
                <div class="flex items-center justify-end gap-3">
                  <a href="/admin/edit/<%= p._id %>" class="text-blue-600 hover:underline">Edit</a>
                  <form action="/admin/delete/<%= p._id %>" method="POST" data-confirm="Ye post permanently delete ho jayega. Pakka?">
                    <button type="submit" class="text-red-600 hover:underline cursor-pointer">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <% if (totalPages > 1) { %>
      <div class="flex justify-center items-center gap-4 mt-6">
        <% if (page > 1) { %>
          <a href="/admin/posts?page=<%= page - 1 %>" class="px-4 py-2 border border-zinc-300 rounded text-sm font-semibold hover:bg-zinc-100">Previous</a>
        <% } %>
        <span class="text-sm text-zinc-600">Page <%= page %> of <%= totalPages %></span>
        <% if (page < totalPages) { %>
          <a href="/admin/posts?page=<%= page + 1 %>" class="px-4 py-2 border border-zinc-300 rounded text-sm font-semibold hover:bg-zinc-100">Next</a>
        <% } %>
      </div>
    <% } %>
  <% } %>
</main>

<script src="/confirm.js" defer></script>

<%- include('../partials/footer') %>