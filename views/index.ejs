<%- include('./partials/header', { title: 'StudentCalc Blog' }) %>

<main class="flex-1 max-w-7xl mx-auto py-6 px-4 w-full">

    <!-- Category Header Banner -->
    <% if (selectedCategory) { %>
        <div class="mb-8 border-b border-zinc-200 pb-4 px-4">
            <h1 class="text-3xl font-bold text-zinc-950" style="font-family: 'Google Sans Code';"><%= selectedCategory %></h1>
            <p class="text-sm text-zinc-500 mt-1">Showing articles published in <%= selectedCategory %></p>
        </div>
    <% } %>

    <% if (!hero && (!topStories || topStories.length === 0) && (!recent || recent.length === 0)) { %>
        <!-- Empty State -->
        <div class="text-center py-20">
            <h2 class="text-2xl font-semibold text-zinc-700" style="font-family: 'Google Sans Code';">No posts published yet.</h2>
            <p class="text-zinc-500 mt-2">Check back later or log in as admin to publish your first post!</p>
            <% if (user && user.role === 'admin') { %>
                <a href="/admin/create" class="inline-block mt-4 px-4 py-2 bg-zinc-950 text-white rounded font-medium text-sm">Publish First Post</a>
            <% } %>
        </div>
    <% } else { %>

        <!-- Hero & Top Stories -->
        <% if (hero || (topStories && topStories.length > 0)) { %>
            <div class="w-full grid md:grid-cols-3 grid-cols-1 gap-6">
                <% if (hero) { %>
                    <a href="/post/<%= hero.slug %>" class="md:col-span-2 px-4 group">
                        <img class="w-full h-[420px] object-cover rounded-sm"
                             src="<%= hero.coverImage?.url || '' %>"
                             alt="<%= hero.coverImage?.alt || hero.title %>">

                        <div class="mt-3">
                            <h1 style="font-family: 'Google Sans Code';" class="md:text-3xl text-2xl text-zinc-950 group-hover:underline font-bold leading-tight">
                                <%= hero.title %>
                            </h1>
                            <p class="mt-2 text-zinc-700 leading-relaxed"><%= hero.excerpt %></p>
                            <div class="flex items-center justify-between mt-3 text-sm text-zinc-950 font-semibold" style="font-family: 'Google Sans Code';">
                                <span>By <%= hero.author?.name || 'Editorial Team' %></span>
                                <%- include('./partials/views-badge', { count: hero.views }) %>
                            </div>
                        </div>
                    </a>
                <% } %>

                <% if (topStories && topStories.length > 0) { %>
                    <div class="md:col-span-1 px-4 [&>a:last-child>hr]:hidden pt-4 md:pt-0 flex flex-col gap-2">
                        <% topStories.forEach(post => { %>
                            <a href="/post/<%= post.slug %>" class="group block">
                                <div class="flex gap-4 items-start">
                                    <img class="h-28 w-28 object-cover rounded-sm flex-shrink-0"
                                         src="<%= post.coverImage?.url || '' %>"
                                         alt="<%= post.coverImage?.alt || post.title %>">

                                    <div>
                                        <h2 class="text-base md:text-lg text-zinc-950 group-hover:underline font-bold leading-snug" style="font-family: 'Google Sans Code';">
                                            <%= post.title %>
                                        </h2>
                                        <div class="text-xs mt-1">
                                            <%- include('./partials/views-badge', { count: post.views }) %>
                                        </div>
                                    </div>
                                </div>
                                <hr class="w-[90%] text-zinc-300 my-3">
                            </a>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        <% } %>

        <!-- Bottom Feed Grid + Load More -->
        <% if (recent && recent.length > 0) { %>
            <% if (hero || (topStories && topStories.length > 0)) { %>
                <hr class="w-[95%] text-zinc-300 my-8 mx-auto hidden md:block">
            <% } %>

            <div id="postGrid" class="grid md:grid-cols-4 grid-cols-1 gap-4">
                <%- include('./partials/cards', { recent }) %>
            </div>

            <% if (page < totalPages) { %>
                <div class="flex justify-center mt-10">
                    <a id="loadMoreBtn"
                       href="/?page=<%= page + 1 %><%= selectedCategory ? '&category=' + selectedCategory : '' %>"
                       data-next-page="<%= page + 1 %>"
                       data-total-pages="<%= totalPages %>"
                       data-category="<%= selectedCategory || '' %>"
                       class="px-6 py-2.5 border border-zinc-950 text-zinc-950 rounded text-sm font-semibold hover:bg-zinc-950 hover:text-white transition cursor-pointer">
                        Load more
                    </a>
                </div>
            <% } %>
        <% } %>

    <% } %>
</main>

<script src="/loadmore.js" defer></script>

<%- include('./partials/footer') %>