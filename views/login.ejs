<%- include('./partials/header', { title: 'Login - StudentCalc Blog' }) %>

<main class="max-w-md mx-auto my-12 p-6 bg-white border border-zinc-200 rounded-md">
  <h2 class="text-2xl font-bold mb-6 text-zinc-950" style="font-family: 'Google Sans Code';">Sign In</h2>

  <% if (error) { %>
    <div class="mb-4 p-3 bg-red-100 text-red-700 text-sm rounded"><%= error %></div>
  <% } %>

  <form action="/login" method="POST" class="space-y-4">
    <div>
      <label for="email" class="block text-sm font-medium text-zinc-700 mb-1">Email Address</label>
      <input type="email" id="email" name="email" required class="w-full px-3 py-2 border border-zinc-300 rounded focus:outline-none focus:border-zinc-950">
    </div>

    <div>
      <label for="password" class="block text-sm font-medium text-zinc-700 mb-1">Password</label>
      <input type="password" id="password" name="password" required class="w-full px-3 py-2 border border-zinc-300 rounded focus:outline-none focus:border-zinc-950">
    </div>

    <button type="submit" class="w-full py-2 bg-zinc-950 text-white font-medium rounded hover:bg-zinc-800 transition">Login</button>
  </form>

  <p class="mt-4 text-sm text-zinc-600 text-center">
    Don't have an account? <a href="/register" class="text-zinc-950 font-semibold underline">Register here</a>
  </p>
</main>

<%- include('./partials/footer') %>